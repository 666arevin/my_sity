/* блок в котром будет чат с пользователем */
.chat-areae {
    display: none;
    flex-direction: column;
    align-items: center;


    width: 48%;
    /* height: 70rem; */
    min-width: 60rem;
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 0.1rem;

    box-sizing: border-box;
    background-color: #171717;
    border-radius: 16px;
    border: 2px solid #000000;

    overflow-y: auto;
}

/* основной блок в котром будет все лежать */
.chat-block {
    margin-top: 25rem;
    max-width: 40rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    /* настройка текста */
    color: #fff;
    font-size: larger;

    transition: 1s;
}

.chat-wrapper.active {
    & .service-info {
        display: block;
    }

    & .chat-block{
        margin-top: auto;
    }

